{
  "name": "ink-behaviors",
  "version": "0.0.0",
  "description": "Unofficial community package: headless behavior hooks (keys and state, no rendering) for Ink lists and menus.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ink",
    "react",
    "cli",
    "terminal",
    "tui",
    "headless",
    "hooks",
    "typeahead"
  ],
  "license": "MIT AND Apache-2.0",
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.3.0",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
